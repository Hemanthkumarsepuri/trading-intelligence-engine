# ============================================================
# TIRE ENVIRONMENT CONFIGURATION
# ============================================================

APP_ENV=development
APP_NAME=trading-intelligence-engine

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tire

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM placeholders (unused by the research engine). qwen3:30b is not the
# live explanation path -- see QWEN_* below.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:30b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:30b

# Local Qwen 2.5 (LM Studio OpenAI-compatible -- Arqon-proven). Fail-open.
QWEN_ENABLED=true
QWEN_BASE_URL=http://127.0.0.1:1234/v1
QWEN_MODEL=qwen2.5-coder-7b-instruct
QWEN_TIMEOUT_SECONDS=45

# Optional API providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Market data providers — Upstox is the selected primary for the read-only
# analysis engine (see docs/data-sources/PROVIDER_DECISION.md); Dhan remains
# implemented as an alternative.
MARKET_DATA_PROVIDER=upstox

# Upstox Analytics Token (read-only; cannot place/modify/cancel orders even
# in principle — see docs/data-sources/PROVIDER_DECISION.md). Generate once,
# manually, from the Upstox Developer dashboard's "Analytics" tab (no OAuth
# flow, no client secret needed) — valid 1 year.
UPSTOX_BASE_URL=https://api.upstox.com
UPSTOX_ACCESS_TOKEN=

# DhanHQ v2 (data/research use only - no order placement code exists in this project)
DHAN_BASE_URL=https://api.dhan.co
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Data freshness thresholds (seconds) — see docs/architecture/ARCHITECTURE.md Addendum A2
FRESHNESS_MAX_AGE_REAL_TIME_SECONDS=15
FRESHNESS_MAX_AGE_SHORT_INTERVAL_SECONDS=60
FRESHNESS_MAX_AGE_ANALYSIS_INTERVAL_SECONDS=360
FRESHNESS_MAX_AGE_SLOW_REFRESH_SECONDS=86400

# Cross-provider validation tolerance (fractional, e.g. 0.005 = 0.5%)
PROVIDER_DISAGREEMENT_TOLERANCE=0.005

# System kill switch — see docs/operations/OPERATING_MODEL.md
SYSTEM_HALTED=false

# IMPORTANT:
# Phase 1 MUST NOT contain broker order credentials.
BROKER_ORDER_EXECUTION_ENABLED=false

# Risk
MAX_RISK_PER_TRADE=0
MAX_DAILY_LOSS=0
MAX_OPEN_POSITIONS=0

# Scheduler
ANALYSIS_INTERVAL_MINUTES=5

# Timezone
TIMEZONE=Asia/Kolkata

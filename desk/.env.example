# TIRE Desk environment. Names only - never commit real values.
# Production values live in the Railway service (API) and the Netlify site (proxy).
# Local development reads these from your shell or a local .env loader of your choice.

# ===== Railway: TIRE Desk API service ==========================================
# Required
SESSION_SECRET=            # 64 hex chars: openssl rand -hex 32
APP_PASSWORD_HASH=         # from: npm run hash-password   (quote it if your shell expands $)
DESK_DATA_DIR=/data/desk   # on the service's own Railway volume (mounted at /data)
DESK_PUBLIC_ORIGIN=        # https origin of the Netlify site, e.g. https://tire-desk.netlify.app
DESK_PROXY_SECRET=         # 48+ random chars: openssl rand -hex 24  (same value on Netlify)
# Optional
DESK_ALLOWED_ORIGINS=      # extra exact https origins allowed to write (comma separated); usually empty
DESK_SCHEDULER=            # on|off. Defaults to on in production; must be on in exactly one service
UPSTOX_ANALYTICS_TOKEN=    # read-only Upstox Analytics token (option chains, official quotes, IPOs)
TELEGRAM_BOT_TOKEN=        # see TELEGRAM_SETUP.md; never share it in chat or put it in Netlify
TELEGRAM_CHAT_ID=
TIRE_ENGINE_URL=           # optional, e.g. http://<engine>.railway.internal:<port>; health probe only

# ===== Netlify: TIRE Desk site (scope: Functions) ===============================
DESK_API_ORIGIN=           # https origin of the Railway Desk API service
# DESK_PROXY_SECRET=       # same value as on Railway

# ===== Local development only ===================================================
APP_PASSWORD=              # plain-text dev password; ignored in production
DESK_OFFLINE=              # 1 = synthetic demo data, no network; refused in production
DESK_STORAGE=              # memory|file (default file under .devdata)

{
  "name": "tire-desk",
  "version": "1.0.0",
  "private": true,
  "description": "TIRE Desk - personal Indian-markets monitor, trading journal, risk guard and portfolio tracker. Frontend on Netlify, API + scheduler on Railway.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx server/dev.ts",
    "dev:web": "vite",
    "build": "npm run build:web",
    "build:web": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "build:server": "esbuild server/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-server/main.cjs --log-level=warning",
    "start": "node dist-server/main.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "hash-password": "node scripts/hash-password.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build:web && npm run build:server"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "fast-xml-parser": "^5.11.2",
    "lightweight-charts": "^4.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  }
}
